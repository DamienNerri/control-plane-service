# Copier ce fichier en .env et remplacer les valeurs factices.
# Ne jamais commiter le fichier .env.

ENV=dev

# Base de données (docker-compose)
POSTGRES_USER=cp_owner
POSTGRES_PASSWORD=changeme
POSTGRES_DB=control_plane

# Connexion de l'application
DATABASE_URL=postgresql+asyncpg://cp_app:changeme@localhost:5432/control_plane
DATABASE_MIGRATION_URL=postgresql+asyncpg://cp_owner:changeme@localhost:5432/control_plane

# Moteur d'évaluation : chain ou sql
EVALUATION_ENGINE=chain
LOG_LEVEL=INFO
